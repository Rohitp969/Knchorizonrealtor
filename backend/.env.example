# Copy to .env and fill in. .env is gitignored; never commit real credentials.

# Server
PORT=5000

# ---------------------------------------------------------------------------
# Supabase PostgreSQL — the live database
# ---------------------------------------------------------------------------
# Supavisor *session* pooler, port 5432 (not 6543: transaction pooling does not
# support the prepared statements and multi-statement scripts this app runs).
# A password containing @ : / or ? must be percent-encoded.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Optional. Paste Supabase's CA certificate (Project Settings -> Database -> SSL
# configuration) to turn on full certificate verification. Without it the
# connection is still encrypted, but the certificate chain is not verified.
# DATABASE_SSL_CA=

# Optional connection pool size (default 10).
# DATABASE_POOL_MAX=10

# ---------------------------------------------------------------------------
# MongoDB — kept only as the migration source and rollback target
# ---------------------------------------------------------------------------
# The running API no longer reads these. They are required by
# scripts/export-mongo.mjs and scripts/migrate-mongo-to-postgres.mjs.
MONGODB_URI=
MONGODB_DB=knc_horizon

# Security - use long random values in production
JWT_SECRET=
SESSION_SECRET=

# Frontend origin(s), comma separated if needed
CLIENT_URL=http://localhost:5173

# Admin account. Re-applied to the users table on every start-up, so changing
# ADMIN_PASSWORD here changes the sign-in password for this account.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Frontend -> Backend API
API_SERVER_URL=http://localhost:5000
VITE_API_URL=http://localhost:5000

# Optional: only if you configure an image upload provider
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Outgoing mail for lead alerts (Admin > Settings > "Send lead alerts to").
# Leave these unset and enquiries are still stored and shown in the admin console; only the
# email notification is skipped, and the Settings screen says so. Port 465 uses implicit TLS,
# anything else (587) starts plain and upgrades with STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional: the From address. Falls back to SMTP_USER.
SMTP_FROM=
