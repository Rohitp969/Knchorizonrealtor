{
  "name": "knc-horizon-realtor-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "nodemon",
    "dev:node-watch": "node --watch src/index.ts",
    "start": "node src/index.ts",
    "build": "node ./build.mjs",
    "start:bundle": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:schema": "node scripts/apply-schema.mjs",
    "db:export-mongo": "node scripts/export-mongo.mjs",
    "db:migrate": "node scripts/migrate-mongo-to-postgres.mjs",
    "db:verify": "node scripts/migrate-mongo-to-postgres.mjs --verify",
    "db:verify-data": "node scripts/verify-data.mjs",
    "test:api": "node scripts/test-api.mjs"
  },
  "nodemonConfig": {
    "watch": [
      "src"
    ],
    "ext": "ts,json,sql",
    "ignore": [
      "dist",
      "backups",
      "artifacts",
      "node_modules"
    ],
    "exec": "node src/index.ts",
    "delay": 300
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.3.0",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^25.3.3",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.25.8",
    "esbuild-plugin-pino": "^2.3.3",
    "mongodb": "^7.6.0",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0",
    "typescript": "^7.0.2"
  }
}
