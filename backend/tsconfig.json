{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],

    "module": "ESNext",
    "moduleResolution": "Bundler",

    // The server runs its TypeScript directly (`node src/index.ts`), so relative imports
    // carry an explicit .ts extension the way Node's ESM resolver requires. tsc only ever
    // typechecks here - esbuild (npm run build) produces the bundle - hence noEmit.
    "allowImportingTsExtensions": true,
    "noEmit": true,
    // Node strips types, it does not compile them: keep the source free of enums,
    // namespaces, parameter properties and anything else that needs real codegen.
    "erasableSyntaxOnly": true,

    "rootDir": "src",

    "strict": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "strictNullChecks": true,
    "strictFunctionTypes": false,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,

    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,

    "isolatedModules": true,
    "useUnknownInCatchVariables": true,
    "alwaysStrict": true,

    "noUnusedLocals": false,
    "noUnusedParameters": false,

    "skipLibCheck": true,

    "incremental": true,
    "tsBuildInfoFile": ".tsbuildinfo",

    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist"
  ]
}